# Required for the web_search tool (get a key at https://firecrawl.dev)
FIRECRAWL_API_KEY=your_api_key_here

# Optional: override any config.yaml setting via MCPRAG_<SETTING_NAME>
# MCPRAG_DATA_DIR=./data
# MCPRAG_FILE_TYPES=md,txt,pdf
# MCPRAG_QDRANT_MODE=local          # local, memory, or server
# MCPRAG_QDRANT_LOCAL_PATH=./qdrant_data
# MCPRAG_QDRANT_URL=http://localhost:6333
# MCPRAG_COLLECTION_NAME=knowledge_base
# MCPRAG_EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
# MCPRAG_CHUNK_SIZE=500
# MCPRAG_CHUNK_OVERLAP=50
# MCPRAG_SEARCH_TOP_K=3
# MCPRAG_SEARCH_SCORE_THRESHOLD=0.66
# MCPRAG_LOG_LEVEL=INFO
